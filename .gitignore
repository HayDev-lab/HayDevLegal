# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# Root-only scratch files. NEVER use a bare `local-*` pattern: it silently
# ignores nested source dirs (it ate the local-laws adapter once).
/local-*
!src/lib/legal-search/local-laws/
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# Root-only scratch dirs. NEVER use bare `test`/`prompt` patterns: they match
# nested paths too (the `test` pattern ate src/app/api/test/ once).
/test
/prompt

server.log
# Skills directory
/skills/

# Phase 4.1 — sandbox scratch dirs / agent work records (never commit)
/agent-ctx/
/tool-results/
/upload/
/.zscripts/
*.pid