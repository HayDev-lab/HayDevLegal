# HayDevLegal — Environment Configuration Example
# Copy this file to `.env` and fill in the values you need.
# NEVER commit your real .env file. The .env file is gitignored.

# ---------------------------------------------------------------------------
# Database (REQUIRED — default SQLite, no external DB server needed)
# ---------------------------------------------------------------------------
# Default: SQLite file in the project's db/ directory.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# On Windows, use a path like:
# DATABASE_URL="file:C:/Users/YourName/HayDevLegal/db/custom.db"

# ---------------------------------------------------------------------------
# QA Endpoint Protection (Phase 4.1 §9-10)
# ---------------------------------------------------------------------------
# Default: disabled (routes under /api/test/* return 404 in production).
# To enable developer-only QA routes, set to "true" and provide a token.
LEGAL_QA_ENABLED=false
# LEGAL_QA_TOKEN=your-qa-secret-token-here

# ---------------------------------------------------------------------------
# Z-AI (bundled — always available, no configuration needed)
# ---------------------------------------------------------------------------
# Z-AI uses the bundled z-ai-web-dev-sdk. No API key required.
# Optional tuning:
# ZAI_COOLDOWN_MS=4000
# ZAI_MAX_TOKENS=4000
# ZAI_DEFAULT_TIMEOUT_MS=18000

# ---------------------------------------------------------------------------
# Ollama Cloud (OPTIONAL — structured extraction + cloud fallback)
# ---------------------------------------------------------------------------
# To enable, set OLLAMA_CLOUD_ENABLED=true and provide your API key + model.
# Get an API key from https://ollama.com
OLLAMA_CLOUD_ENABLED=false
# OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_CLOUD_HOST=https://ollama.com
# OLLAMA_CLOUD_MODEL=llama3.1:70b

# ---------------------------------------------------------------------------
# Codex CLI + ChatGPT (PRIMARY deep analysis — no API key needed)
# ---------------------------------------------------------------------------
# Codex CLI uses your ChatGPT account login (ChatGPT Pro plan).
# To sign in: run `codex login` in your terminal (opens browser).
# Check status: `codex login status`
CODEX_CLI_ENABLED=true
# CODEX_CLI_PATH=            # Optional: explicit path to codex binary
# CODEX_MODEL=               # Optional: override default model
CODEX_REASONING_EFFORT=medium

# ---------------------------------------------------------------------------
# Codex SDK / API-key (OPTIONAL — separate API-billed transport)
# ---------------------------------------------------------------------------
# Only enable if you explicitly want API-billing (not ChatGPT plan quota).
# NEVER enabled by default. Never silently switched to when CLI is rate-limited.
CODEX_SDK_ENABLED=false
# CODEX_API_KEY=your-openai-api-key
# CODEX_MODEL=gpt-5-codex

# ---------------------------------------------------------------------------
# Case Workspace Storage (Phase 5)
# ---------------------------------------------------------------------------
# Where uploaded case files are stored (opaque storage keys, not user paths).
CASE_STORAGE_ROOT=/tmp/haydevlegal-case-storage

# On Windows:
# CASE_STORAGE_ROOT=C:/Users/YourName/AppData/Local/HayDevLegal/case-storage

# ---------------------------------------------------------------------------
# Draft Storage (Phase 6)
# ---------------------------------------------------------------------------
DRAFT_STORAGE_ROOT=/tmp/haydevlegal-drafts

# On Windows:
# DRAFT_STORAGE_ROOT=C:/Users/YourName/AppData/Local/HayDevLegal/drafts

# ---------------------------------------------------------------------------
# AI Runtime (Phase 4.1 — optional tuning)
# ---------------------------------------------------------------------------
# AI_RUNTIME_MAX_ATTEMPTS=3
# AI_RUNTIME_PROVIDER_MIN_TIME_MS=2000
# AI_RUNTIME_DEFAULT_DEADLINE_MS=30000
